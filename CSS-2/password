/* =========================
   Password Checker Styles
========================= */

body {
  margin: 0;
  padding: 0;
  font-family: 'Share Tech Mono', monospace;
  color: #ff4c4c;
  text-align: center;
  background: url('assets-2/cyber-strength-bg.png') no-repeat center center fixed;
  background-size: cover;
  position: relative;
  overflow: hidden;
}

/* Dark overlay + blur */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(4px);
  z-index: -1;
}

/* Header text */
header {
  padding: 80px 20px 20px 20px;
}

header h1 {
  font-size: 3em;
  margin-bottom: 10px;
  color: #ff4c4c;
  text-shadow: 0 0 8px #ff1a1a, 0 0 20px #ff6666;
}

/* Instruction text bigger */
#instruction {
  font-size: 2.5em; /* bigger, fills more screen */
  max-width: 90%;
  margin: 20px auto;
  line-height: 1.3em;
  color: #ff9999;
  text-shadow: 0 0 10px #ff2a2a, 0 0 20px #ff4c4c;
}

/* Input box */
#password-input {
  padding: 15px;
  font-size: 1.4em;
  width: 300px;
  max-width: 80%;
  border: 2px solid #ff4c4c;
  border-radius: 8px;
  outline: none;
  background: rgba(0,0,0,0.4);
  color: #ff4c4c;
  text-shadow: 0 0 4px #ff6666;
  box-shadow: 0 0 10px #ff4c4c inset;
  transition: 0.3s;
}

#password-input:focus {
  box-shadow: 0 0 20px #ff1a1a inset;
  border-color: #ff1a1a;
}

/* Feedback container */
#feedback {
  margin-top: 30px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 400px;
  margin-left: auto;
  margin-right: auto;
}

/* Feedback messages */
.feedback-line {
  opacity: 0;
  font-size: 1.2em; /* smaller than instruction */
  color: #ff9999;
  text-shadow: 0 0 5px #ff4c4c;
  background: rgba(0,0,0,0.3);
  border: 1px solid #ff4c4c;
  border-radius: 6px;
  padding: 10px;
  transform: translateY(10px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

/* Show feedback lines one by one */
.feedback-line.show {
  opacity: 1;
  transform: translateY(0);
}

/* Back button */
.back {
  margin-top: 30px;
  padding: 10px 20px;
  border: 1px solid #ff4c4c;
  background: rgba(0,0,0,0.3);
  color: #ff4c4c;
  border-radius: 8px;
  cursor: pointer;
  transition: 0.2s;
  text-shadow: 0 0 5px #ff9999;
}

.back:hover {
  transform: scale(1.08);
  box-shadow: 0 0 15px #ff4c4c;
}

/* Optional: check button (if used) */
#check-btn {
  margin-top: 25px;
  padding: 12px 25px;
  font-size: 1.3em;
  border: 1px solid #ff4c4c;
  border-radius: 8px;
  background: rgba(0,0,0,0.4);
  color: #ff4c4c;
  cursor: pointer;
  text-shadow: 0 0 5px #ff9999;
  transition: 0.2s;
}

#check-btn:hover {
  transform: scale(1.08);
  box-shadow: 0 0 15px #ff4c4c;
  background: rgba(0,0,0,0.2);
}

