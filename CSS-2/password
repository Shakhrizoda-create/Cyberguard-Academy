/* css-2.css */

/* === General Body & Background === */
body {
  margin: 0;
  padding: 0;
  font-family: 'Share Tech Mono', monospace;
  color: #ff2e2e; /* bright red */
  text-align: center;
  background: url('assets-2/cyber-strength-bg.png') no-repeat center center fixed;
  background-size: cover;
  position: relative;
  overflow-x: hidden;
  min-height: 100vh;
}

/* Dark overlay + slight blur */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  background: rgba(20, 0, 0, 0.75); /* dark red-ish overlay */
  backdrop-filter: blur(4px);
  z-index: -1;
}

/* === Header / Title === */
h1, h2 {
  margin-top: 50px;
  text-shadow: 0 0 10px #ff3c3c, 0 0 20px #ff4f4f;
  letter-spacing: 2px;
}

h1 {
  font-size: 3.2rem;
}

h2 {
  font-size: 1.8rem;
  margin-bottom: 20px;
  color: #ff5959;
}

/* === Password Input Container === */
.password-container {
  margin: 30px auto;
  max-width: 400px;
  display: flex;
  flex-direction: column;
  gap: 15px;
  padding: 0 15px;
}

/* === Password Input Box === */
#password-input {
  padding: 15px 20px;
  font-size: 1.5rem;
  font-family: 'Share Tech Mono', monospace;
  border: 2.5px solid #ff2e2e;
  border-radius: 12px;
  outline: none;
  color: #ffeded;
  background-color: rgba(40, 0, 0, 0.7);
  box-shadow: 0 0 15px #ff2e2e;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

/* Glow on focus */
#password-input:focus {
  border-color: #ff4949;
  box-shadow: 0 0 25px #ff4949;
}

/* === Feedback Container === */
#feedback {
  margin-top: 30px;
  max-width: 420px;
  margin-left: auto;
  margin-right: auto;
  text-align: left;
  font-size: 1.2rem;
  color: #ff7777;
  line-height: 1.6;
}

/* Each feedback line hidden initially */
.feedback-line {
  opacity: 0;
  transform: translateX(-15px);
  animation-fill-mode: forwards;
}

/* Fade-in + slide right animation */
@keyframes fadeSlideIn {
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* === Footer or Extra Button Styling (optional) === */
button.check-btn {
  margin: 20px auto 50px;
  padding: 15px 30px;
  font-size: 1.3rem;
  font-family: 'Share Tech Mono', monospace;
  background-color: #660000;
  border: 2px solid #ff2e2e;
  border-radius: 10px;
  color: #ff9999;
  cursor: pointer;
  box-shadow: 0 0 12px #ff2e2e;
  transition: background-color 0.25s ease;
}

button.check-btn:hover {
  background-color: #aa0000;
  color: #fff0f0;
  box-shadow: 0 0 25px #ff4949;
}

